# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า — ห้าม commit .env และห้ามใส่คีย์จริงในไฟล์ .env.example
# ตรวจความพร้อมก่อนเปิดจริง: NODE_ENV=production npm run check:env

# ===== เซิร์ฟเวอร์ =====
PORT=3000
NODE_ENV=development
# URL สาธารณะของเว็บ (ใช้สร้างลิงก์ในอีเมล, canonical, sitemap, OG) — production ต้องเป็น https://โดเมนจริง
APP_URL=http://localhost:3000
DATABASE_PATH=./data/store.db
# อยู่หลัง reverse proxy (Caddy/nginx/Cloudflare)? ใส่จำนวน proxy ที่เชื่อถือได้ (ปกติ 1) เพื่อให้ได้ IP จริงของลูกค้า
# ถ้าไม่ได้อยู่หลัง proxy ให้เว้นว่าง (ถ้าใส่ผิด ผู้โจมตีปลอม IP หลบ rate limit ได้)
TRUST_PROXY=
# โดเมนที่อนุญาตให้เรียก API ข้ามเว็บ (คั่นด้วย ,) — ค่าเริ่มต้น = เฉพาะ APP_URL (เว็บและ API อยู่โดเมนเดียวกันไม่ต้องตั้ง)
CORS_ORIGINS=
# 0 = ปิด access log (ปกติเปิด; log เก็บเฉพาะ method + path + status ไม่เก็บ query/cookie/body)
LOG_REQUESTS=1
# ใช้ไฟล์ที่ build แล้วใน dist/ แม้ไม่ใช่ production (production ใช้ dist/ อยู่แล้ว)
USE_DIST=

# ===== ความปลอดภัย (production ปฏิเสธการเริ่มระบบถ้าเป็นค่าตัวอย่าง/สั้นกว่า 32 ตัว/ซ้ำกัน) =====
# สร้างค่า: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# จำนวนครั้งสูงสุดต่อ 15 นาที ต่อ IP สำหรับ login/register/forgot
AUTH_RATE_LIMIT=20
# จำนวนคำขอ /api ต่อนาทีต่อ IP
API_RATE_LIMIT=300

# ===== โค้ดเกม =====
# ใช้เข้ารหัสโค้ดเกมในฐานข้อมูล (AES-256-GCM) — ต้องไม่ซ้ำกับ JWT_SECRET และ **ห้ามเปลี่ยนภายหลัง/ห้ามทำหาย**
# ไม่งั้นถอดรหัสโค้ดเดิมไม่ได้ (สำรองไว้แยกจากฐานข้อมูล)
KEY_ENCRYPTION_SECRET=change-me-to-another-long-random-string

# ===== ชำระเงิน (Stripe) =====
# ตอนพัฒนาใช้คีย์โหมดทดสอบ sk_test_... ; เปิดขายจริงเปลี่ยนเป็น sk_live_... (ดู docs/CHECKLIST.md)
# ถ้าเว้นว่าง ระบบยังรันได้ในโหมดพัฒนา (ปุ่มชำระเงินจำลอง) แต่ production ไม่ยอมเริ่ม
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# ได้จาก `stripe listen` (ตอนพัฒนา) หรือ Dashboard → Developers → Webhooks (ตอน deploy) รูปแบบ whsec_...
STRIPE_WEBHOOK_SECRET=

# ===== ข้อมูลร้าน (แสดงในใบเสร็จ/ใบกำกับภาษี — ต้องแก้เป็นข้อมูลจริงก่อนเปิดขาย) =====
SHOP_NAME=Game Store Co., Ltd.
SHOP_ADDRESS=123 ถนนตัวอย่าง แขวงตัวอย่าง เขตตัวอย่าง กรุงเทพมหานคร 10000
SHOP_TAX_ID=0000000000000

# ===== คำสั่งซื้อ =====
# ออเดอร์ที่รอชำระเกินกี่นาทีจะหมดอายุอัตโนมัติ (ค่าเริ่มต้น 30)
ORDER_EXPIRY_MINUTES=30
# 1 = เปิดปุ่ม "จำลองการชำระเงิน" (ให้โค้ดเกมโดยไม่จ่ายเงิน) สำหรับพัฒนาในเครื่องเท่านั้น — ว่าง = ปิด, production เปิดไม่ได้
DEV_PAY=1
# ส่งอีเมลยืนยันซ้ำได้กี่ครั้งต่อ 10 นาทีต่อผู้ใช้
EMAIL_RESEND_LIMIT=5

# ===== อีเมล (SMTP) =====
# ถ้าไม่ตั้ง SMTP_HOST ระบบจะพิมพ์ลิงก์ยืนยัน/รีเซ็ตลง console แทน (โหมด dev เท่านั้น — production ต้องตั้ง)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Game Store <no-reply@example.com>

# ===== สิทธิ์ของ staff =====
# ค่าเริ่มต้น (เว้นว่าง) = staff ดูข้อมูล/ออเดอร์/รีวิว และยกเลิกออเดอร์ที่ยังไม่จ่ายได้เท่านั้น
# เพิ่มสิทธิ์ได้ทีละรายการ คั่นด้วย , :
#   games.write     = เพิ่ม/แก้/ลบเกม และอัปโหลดรูป
#   stock.write     = นำเข้าโค้ดเกม, ตั้งค่าเกณฑ์สต็อกต่ำ, เพิกถอนโค้ด
#   coupons.manage  = จัดการคูปอง
#   reports.users   = ดาวน์โหลดรายงานผู้ใช้ใหม่ (CSV)
# ยังเป็นของ admin เท่านั้นเสมอ: คืนเงิน, เปิดดูโค้ดเต็ม, จัดการผู้ใช้/บทบาท, audit log
STAFF_PERMISSIONS=

# ===== สำรองข้อมูล (npm run backup) =====
BACKUP_DIR=./backups
# เก็บสำรองล่าสุดกี่ชุด (ค่าเริ่มต้น 14)
BACKUP_KEEP=14

# ===== ตัวเลือกพิเศษ (ปกติไม่ต้องตั้ง) =====
# 1 = อนุญาต APP_URL เป็น http:// ใน production (เช่น ทดสอบ Docker ในเครื่องก่อนมีโดเมน) — ห้ามใช้ตอนเปิดขายจริง
ALLOW_HTTP_APP_URL=
# 1 = อนุญาต seed ข้อมูลตัวอย่าง (เกม/คูปอง/โค้ดปลอม) ใน production — ห้ามใช้กับร้านจริง
ALLOW_DEMO_SEED=
